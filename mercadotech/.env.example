# --- Supabase ---
# URL del proyecto Supabase (Settings > API > Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (Settings > API > Project API keys > anon public).
# Segura para exponer en el cliente: su alcance queda limitado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (Settings > API > Project API keys > service_role).
# BYPASEA Row Level Security. Solo se usa en lib/supabase/admin.ts, que es
# server-only. Nunca debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al
# cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# URL pública del sitio (usada para construir links absolutos, ej. en
# emails de auth). En desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- IA (Hugging Face, nivel gratuito) ---
# Token personal (Settings > Access Tokens > Create new token, tipo Read
# alcanza). Empieza con "hf_". Vive SOLO en .env.local, nunca en un commit
# ni en el chat con Claude.
HUGGINGFACEHUB_API_TOKEN=

# Modelo de embeddings. Opcional: si se omite, el código usa el default
# documentado en lib/constants/ai.ts (sentence-transformers/all-MiniLM-L6-v2,
# 384 dimensiones — cambiar de dimensión exige migración, no solo esta var).
HUGGINGFACE_EMBEDDING_MODEL=

# Modelo de chat. Opcional: si se omite, el código usa el default
# documentado en lib/constants/ai.ts (meta-llama/Llama-3.1-8B-Instruct). La
# disponibilidad de modelos gratuitos de Hugging Face rota sin aviso — si
# el default deja de responder, reemplazar SOLO esta variable.
HUGGINGFACE_CHAT_MODEL=
