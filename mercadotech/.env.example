# --- Supabase ---
# URL del proyecto Supabase (Settings > API > Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (Settings > API > Project API keys > anon public).
# Segura para exponer en el cliente: su alcance queda limitado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (Settings > API > Project API keys > service_role).
# BYPASEA Row Level Security. Solo se usa en lib/supabase/admin.ts, que es
# server-only. Nunca debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al
# cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# URL pública del sitio (usada para construir links absolutos, ej. en
# emails de auth). En desarrollo: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Las variables de integración de IA (Hugging Face) se agregan en la
# Sesión 4 — no pertenecen a esta fase.
